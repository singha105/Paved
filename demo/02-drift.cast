{"version":3,"term":{"cols":100,"rows":30},"timestamp":1789319589,"idle_time_limit":2.0,"command":"./demo/02-drift.sh","title":"paved: a deleted PrometheusRule comes back","env":{"SHELL":"/bin/zsh"}}
[0.460, "o", "\r\n\u001b[1;36m# A claim, and the PrometheusRule the controller generated for it\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m kubectl get serviceclaim url-shortener -n platform-claims\r\n"]
[0.190, "o", "NAME            TIER     OWNER        BUDGET   FROZEN   READY   AGE\r\nurl-shortener   public   team-links   0.0%              False   11h\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m kubectl get prometheusrule -n svc-url-shortener\r\n"]
[0.084, "o", "NAME            AGE\r\nurl-shortener   61s\r\n"]
[0.003, "o", "\r\n\u001b[1;36m# Someone deletes the rules by hand\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m kubectl delete prometheusrule -n svc-url-shortener --all\r\n"]
[0.046, "o", "prometheusrule.monitoring.coreos.com \"url-shortener\" deleted from svc-url-shortener namespace\r\n"]
[0.057, "o", "\r\n\u001b[1;36m# Wait for the controller to notice and put them back\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m kubectl wait --for=create prometheusrule/url-shortener -n svc-url-shortener --timeout=60s\r\n"]
[0.049, "o", "prometheusrule.monitoring.coreos.com/url-shortener condition met\r\n"]
[0.023, "o", "\u001b[1;32m$\u001b[0m kubectl get prometheusrule -n svc-url-shortener\r\n"]
[0.465, "o", "NAME            AGE\r\nurl-shortener   1s\r\n"]
[0.001, "o", "\r\n\u001b[1;36m# Restored 72 ms after the delete returned\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "\u001b[1;36m# The controller records what it fixed as an Event on the claim\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m kubectl get events -n platform-claims --field-selector reason=DriftCorrected\r\n"]
[0.051, "o", "LAST SEEN"]
[0.000, "o", "   TYPE     REASON           OBJECT                       MESSAGE\r\n67s         Normal   DriftCorrected   serviceclaim/url-shortener   Recreated PrometheusRule svc-url-shortener/url-shortener"]
[0.000, "o", "\r\n61s         Normal   DriftCorrected"]
[0.000, "o", "   "]
[0.000, "o", "serviceclaim/url-shortener"]
[0.000, "o", "   Recreated PrometheusRule svc-url-shortener/url-shortener\r\n"]
[0.000, "o", "0s          Normal   DriftCorrected   serviceclaim/url-shortener"]
[0.000, "o", "   "]
[0.000, "o", "Recreated PrometheusRule svc-url-shortener/url-shortener"]
[0.000, "o", "\r\n"]
[0.002, "x", "0"]
