[0.036, "o", "No 28d error budget left; image changes are rejected until 5.0% of it is back"]
[0.001, "o", "\r\n"]
[0.000, "o", "\r\n\u001b[1;36m# The next release, 0.2.0, is ready. Try to ship it\u001b[0m\r\n\u001b[1;32m$\u001b[0m kubectl patch serviceclaim url-shortener -n platform-claims --type merge -p '{\"spec\":{\"image\":\"k3d-paved-registry:5001/testsvc:0.2.0\"}}'\r\n"]
[0.127, "o", "Error from server (Forbidden): admission webhook \"vserviceclaim-v1alpha1.paved.dev\" denied the request: deploys frozen: url-shortener has 0% error budget remaining in a 28d window (burn rate 1.0x). Override with annotation paved.dev/break-glass=\"<reason>\" — this is audited.\r\n"]
[0.000, "o", "\r\n\u001b[1;36m# An urgent hotfix can still go out, on the record: break-glass with a reason\u001b[0m\r\n\u001b[1;32m$\u001b[0m kubectl patch serviceclaim url-shortener -n platform-claims --type merge -p '{\"metadata\":{\"annotations\":{\"paved.dev/break-glass\":\"INC-1234: hotfix for the 500s\"}},\"spec\":{\"image\":\"k3d-paved-registry:5001/testsvc:0.1.2\"}}'\r\n"]
[0.110, "o", "\u001b[33;1mWarning:\u001b[0m deploys are frozen: this image change was let through by paved.dev/break-glass and recorded in a BreakGlassUsed Event\r\n"]
[0.000, "o", "serviceclaim.platform.paved.dev/url-shortener patched\r\n"]
[0.001, "o", "  waiting until the BreakGlassUsed Event is recorded\r\n"]
[0.246, "o", "  budget 0.0%    1h burn rate 1.03   DeploysFrozen=True (BudgetExhausted)  Ready=False\r\n"]
[0.038, "o", "\u001b[1;32m$\u001b[0m kubectl get events -n platform-claims --field-selector reason=BreakGlassUsed\r\n"]
[0.047, "o", "LAST SEEN   TYPE      REASON           OBJECT                       MESSAGE\r\n15m         Warning   BreakGlassUsed   serviceclaim/url-shortener   system:admin changed the image from k3d-paved-registry:5001/testsvc:0.1.1 to k3d-paved-registry:5001/testsvc:0.1.2 during a deploy freeze: INC-1234: hotfix for the 500s\r\n8m17s       Warning   BreakGlassUsed   serviceclaim/url-shortener   system:admin changed the image from k3d-paved-registry:5001/testsvc:0.1.1 to k3d-paved-registry:5001/testsvc:0.1.2 during a deploy freeze: INC-1234: hotfix for the 500s\r\n0s"]
[0.000, "o", "          Warning   BreakGlassUsed   serviceclaim/url-shortener   system:admin changed the image from k3d-paved-registry:5001/testsvc:0.1.1 to k3d-paved-registry:5001/testsvc:0.1.2 during a deploy freeze: INC-1234: hotfix for the 500s\r\n"]
[0.001, "o", "\r\n\u001b[1;36m# The override covered that one change. Take the annotation off\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m kubectl annotate serviceclaim url-shortener -n platform-claims paved.dev/break-glass-\r\n"]
[0.067, "o", "serviceclaim.platform.paved.dev/url-shortener annotated\r\n"]
[0.001, "o", "\r\n\u001b[1;36m# The hotfix is out and the errors stop\u001b[0m\r\n"]
[0.537, "o", "\r\n\u001b[1;36m# Good requests win the budget back. To keep the demo short, it now sends much more traffic\u001b[0m\r\n\r\n\u001b[1;36m# Deploys stay frozen until 5% of the budget is back, so they can't flap on and off around zero\u001b[0m\r\n"]
[0.000, "o", "  waiting until deploys unfreeze\r\n"]
[0.391, "o", "  budget 0.0%    1h burn rate 1.03   DeploysFrozen=True (BudgetExhausted)  Ready=False\r\n"]
[26.730, "o", "  budget 0.0%    1h burn rate 1.22   DeploysFrozen=True (BudgetExhausted)  Ready=False\r\n"]
[16.727, "o", "  budget 11.2%   1h burn rate 1.22   DeploysFrozen=False (WithinBudget)  Ready=False\r\n"]
[0.040, "o", "\r\n\u001b[1;36m# Deploys are unfrozen. Retry the same release\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m kubectl patch serviceclaim url-shortener -n platform-claims --type merge -p '{\"spec\":{\"image\":\"k3d-paved-registry:5001/testsvc:0.2.0\"}}'\r\n"]
[0.072, "o", "serviceclaim.platform.paved.dev/url-shortener patched\r\n"]
