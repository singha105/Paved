{"version":3,"term":{"cols":120,"rows":34},"timestamp":1789364571,"idle_time_limit":2.0,"command":"./demo/canary-demo.sh","title":"paved: an SLI-gated canary aborts a bad release","env":{"SHELL":"/bin/zsh"}}
[0.923, "o", "\r\n\u001b[1;36m# url-shortener runs 0.1.1. Argo CD applies its claim from git, and nobody runs kubectl apply\u001b[0m\r\n\u001b[1;32m$\u001b[0m kubectl get applications -n argocd\r\n"]
[0.054, "o", "NAME              SYNC STATUS   HEALTH STATUS\r\npaved             Synced        Healthy\r\npaved-operator    Synced        Healthy\r\nplatform-claims   Synced        "]
[0.000, "o", "Healthy\r\n"]
[0.001, "o", "  waiting until the Rollout is healthy on 0.1.1\r\n"]
[0.361, "o", "  Rollout Healthy     step 5/5  aborted=       analysis               5m error ratio 0.159  claim Ready=True\r\n"]
[0.065, "o", "\r\n\u001b[1;36m# Traffic: a steady trickle of requests for the whole demo\u001b[0m\r\n"]
[0.000, "o", "  waiting until the 5m SLI, the rule the canary analysis reads, has data and no recent errors\r\n"]
[0.301, "o", "  Rollout Healthy     step 5/5  aborted=       analysis               5m error ratio 0.159  claim Ready=True\r\n"]
[50.102, "o", "  Rollout Healthy     step 5/5  aborted=       analysis               5m error ratio 0.134  claim Ready=True\r\n"]
