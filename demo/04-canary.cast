[31.337, "o", "  Rollout Healthy     step 5/5  aborted=       analysis               5m error ratio 0.000  claim Ready=True\r\n"]
[0.083, "o", "\r\n\u001b[1;36m# A bad release, 0.2.1-bad, fails every request. It ships like any release: as a commit to git\u001b[0m\r\n"]
[0.006, "o", "\u001b[1;32m$\u001b[0m git --no-pager diff -- deploy/claims/url-shortener.yaml\r\n"]
[0.027, "o", "diff --git a/deploy/claims/url-shortener.yaml b/deploy/claims/url-shortener.yaml\r\nindex 4ae9365..d64e720 100644\r\n--- a/deploy/claims/url-shortener.yaml\r\n+++ b/deploy/claims/url-shortener.yaml\r\n@@ -7,7 +7,7 @@ metadata:\r\n   namespace: platform-claims\r\n spec:\r\n   owner: team-links\r\n-  image: k3d-paved-registry:5001/testsvc:0.1.1\r\n"]
[0.000, "o", "+  image: k3d-paved-registry:5001/testsvc:0.2.1-bad\r\n   port: 8080\r\n   tier: public\r\n   sli:\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m git commit -m \"demo: ship url-shortener 0.2.1-bad, a release that fails every request\" -- deploy/claims/url-shortener.yaml\r\n"]
[0.025, "o", "\u001b[1;32m$\u001b[0m git push -q origin main\r\n"]
[1.487, "o", "\u001b[1;32m$\u001b[0m kubectl annotate application platform-claims -n argocd argocd.argoproj.io/refresh=normal --overwrite\r\n"]
[0.123, "o", "application.argoproj.io/platform-claims annotated\r\n"]
[0.002, "o", "  waiting until Argo CD applies the claim and paved passes the new image to the Rollout\r\n"]
[0.474, "o", "  Rollout Healthy     step 5/5  aborted=       analysis               5m error ratio 0.000  claim Ready=True\r\n"]
[3.596, "o", "  Rollout Progressing step 1/5  aborted=       analysis Running       5m error ratio 0.000  claim Ready=False\r\n"]
[0.043, "o", "\r\n\u001b[1;36m# The canary starts. From its first pause, the analysis reads the SLI every 30 seconds and fails above 0.05\u001b[0m\r\n"]
[0.000, "o", "  waiting until Argo Rollouts aborts the canary on its own\r\n"]
[0.515, "o", "  Rollout Paused      step 1/5  aborted=       analysis Running       5m error ratio 0.000  claim Ready=False\r\n"]
[53.754, "o", "  Rollout Paused      step 1/5  aborted=       analysis Running       5m error ratio 0.077  claim Ready=False\r\n"]
[7.448, "o", "  Rollout Degraded    step 0/5  aborted=true   analysis               5m error ratio 0.077  claim Ready=False\r\n"]
[0.222, "o", "\r\n\u001b[1;36m# Aborted 62s after the bad image reached the Rollout (applied 2026-09-14T05:45:15Z, aborted 2026-09-14T05:46:17Z)\u001b[0m\r\n\u001b[1;32m$\u001b[0m kubectl argo rollouts get rollout url-shortener -n svc-url-shortener\r\n"]
