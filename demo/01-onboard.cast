[0.003, "o", "\r\n\u001b[1;36m# It serves. An internal service has no Ingress, so reach it through a port-forward\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m kubectl port-forward -n svc-shortlink svc/shortlink 18080:80 &\r\n"]
[1.058, "o", "\u001b[1;32m$\u001b[0m curl -s -X POST localhost:18080/links -d '{\"url\": \"https://github.com/singha105/paved\"}'\r\n"]
[0.013, "o", "{\"code\":\"2fyGEJW\",\"short\":\"/2fyGEJW\",\"url\":\"https://github.com/singha105/paved\"}\r\n"]
[0.050, "o", "\u001b[1;32m$\u001b[0m curl -si localhost:18080/2fyGEJW\r\n"]
[0.017, "o", "HTTP/1.1 302 Found\r\r\nLocation: https://github.com/singha105/paved\r\r\n"]
[0.000, "o", "\r\n\u001b[1;36m# Done: 18 lines of YAML, Ready=True in 7s, with no ticket and no kubectl apply\u001b[0m\r\n"]
[0.000, "o", "onboard_seconds=7 yaml_lines=18\r\n"]
[0.002, "x", "0"]
