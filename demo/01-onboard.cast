{"version":3,"term":{"cols":120,"rows":34},"timestamp":1789404361,"idle_time_limit":2.0,"command":"./demo/onboard-demo.sh","title":"paved: onboarding a second service with one claim","env":{"SHELL":"/bin/zsh"}}
[0.710, "o", "\r\n\u001b[1;36m# shortlink is a URL shortener with its own code, module and image. Nothing runs it yet\u001b[0m\r\n\u001b[1;32m$\u001b[0m ls services/shortlink\r\n"]
[0.003, "o", "Dockerfile\tgo.mod\t\thandler.go\tmain_test.go\r\nREADME.md\tgo.sum\t\tmain.go\t\tstore.go\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m kubectl get serviceclaims -n platform-claims\r\n"]
[0.125, "o", "NAME               TIER     OWNER               BUDGET   FROZEN   READY   AGE\r\nurl-shortener      public   team-links                  "]
[0.000, "o", " False    True    35h\r\nwebhook-delivery   public   team-integrations"]
[0.000, "o", "            "]
[0.000, "o", "False    True"]
[0.000, "o", "    35h"]
[0.000, "o", "\r\n"]
[0.001, "o", "\r\n\u001b[1;36m# Onboarding it is one file. The stopwatch starts when the file is created\u001b[0m\r\n"]
[0.007, "o", "\u001b[1;32m$\u001b[0m cat deploy/claims/shortlink.yaml\r\n"]
[0.002, "o", "apiVersion: platform.paved.dev/v1alpha1\r\nkind: ServiceClaim\r\nmetadata:\r\n  name: shortlink\r\n  namespace: platform-claims\r\nspec:\r\n  owner: team-growth\r\n  image: k3d-paved-registry:5001/shortlink:0.1.0\r\n  port: 8080\r\n  tier: internal\r\n  sli:\r\n    type: http-availability\r\n  slo:\r\n    objective: \"99.9\"\r\n    window: 28d\r\n  scale:\r\n    min: 2\r\n    max: 4\r\n"]
[0.002, "o", "\r\n\u001b[1;36m# 18 lines of YAML. Commit them: Argo CD applies what is on main\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m git add deploy/claims/shortlink.yaml\r\n"]
[0.017, "o", "\u001b[1;32m$\u001b[0m git commit -m \"feat(claims): onboard shortlink, a second service\"\r\n"]
[0.023, "o", "\u001b[1;32m$\u001b[0m git push -q origin main\r\n"]
[1.337, "o", "\u001b[1;32m$\u001b[0m kubectl annotate application platform-claims -n argocd argocd.argoproj.io/refresh=normal --overwrite\r\n"]
[0.105, "o", "application.argoproj.io/platform-claims annotated\r\n"]
[0.002, "o", "  waiting until Argo CD creates the claim, and paved builds the service and reports it Ready\r\n"]
[0.263, "o", "  claim absent   ResourcesSynced=       managed resources     Ready=      \r\n"]
[2.617, "o", "  claim created  ResourcesSynced=       managed resources     Ready=False RolloutProgressing\r\n"]
[2.508, "o", "  claim created  ResourcesSynced=True   managed resources 12  Ready=True  RolloutHealthy\r\n"]
[0.118, "o", "\r\n\u001b[1;36m# Ready=True 7s after the claim file was created (file 2026-09-14T16:46:02Z, Ready 2026-09-14T16:46:09Z)\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m kubectl get serviceclaim shortlink -n platform-claims\r\n"]
[0.034, "o", "NAME        TIER       OWNER         BUDGET   FROZEN   READY   AGE\r\nshortlink   internal   "]
[0.000, "o", "team-growth            False    True    4s\r\n"]
[0.001, "o", "\r\n\u001b[1;36m# What those 18 lines became: the namespace, and everything in it that paved manages\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m kubectl get namespace svc-shortlink\r\n"]
[0.034, "o", "NAME            STATUS   AGE\r\nsvc-shortlink   Active   4s\r\n"]
[0.002, "o", "\u001b[1;32m$\u001b[0m kubectl get serviceaccount,rollout,analysistemplate,service,horizontalpodautoscaler,poddisruptionbudget,networkpolicy,servicemonitor,prometheusrule,configmap -n svc-shortlink -l app.kubernetes.io/managed-by=paved\r\n"]
[0.759, "o", "NAME                       AGE\r\nserviceaccount/shortlink   4s\r\n"]
