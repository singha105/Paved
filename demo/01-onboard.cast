[0.000, "o", "\r\nNAME                                        POD-SELECTOR   AGE\r\nnetworkpolicy.networking.k8s.io/shortlink   <none>         5s\r\n"]
[0.000, "o", "\r\nNAME                                             AGE\r\nservicemonitor.monitoring.coreos.com/shortlink   5s"]
