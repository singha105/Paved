{"version":3,"term":{"cols":120,"rows":34},"timestamp":1789422660,"idle_time_limit":2.0,"command":"./demo/05-storage.sh","env":{"SHELL":"/bin/zsh"}}
[2.515, "o", "\r\n\u001b[1;36m# Two teams need somewhere to put files. Each writes its usual claim, plus one line: storage: true\u001b[0m\r\n"]
[0.008, "o", "apiVersion: platform.paved.dev/v1alpha1\r\nkind: ServiceClaim\r\nmetadata:\r\n  name: invoices\r\n  namespace: platform-claims\r\nspec:\r\n  owner: team-invoices\r\n  image: k3d-paved-registry:5001/testsvc:0.1.1\r\n  port: 8080\r\n  tier: batch\r\n  sli:\r\n    type: http-availability\r\n  slo:\r\n    objective: \"99.5\"\r\n  scale:\r\n    min: 1\r\n    max: 1\r\n  storage: true\r\n"]
[0.153, "o", "\u001b[1;32m$\u001b[0m kubectl apply -f invoices.yaml -f avatars.yaml\r\n"]
[0.000, "o", "  waiting until ACK has created both roles and buckets in AWS, and both services are Ready\r\n"]
[0.184, "o", "  invoices  StorageReady=                         Ready=        avatars   StorageReady=                         Ready=        \r\n"]
[2.345, "o", "  invoices  StorageReady=False Provisioning       Ready=False   avatars   StorageReady=False Provisioning       Ready=False   \r\n"]
[13.395, "o", "  invoices  StorageReady=True  Provisioned        Ready=True    avatars   StorageReady=False Provisioning       Ready=False   \r\n"]
[6.798, "o", "  invoices  StorageReady=True  Provisioned        Ready=True    avatars   StorageReady=True  Provisioned        Ready=True    \r\n"]
[0.282, "o", "\r\n\u001b[1;36m# invoices: StorageReady 16s and Ready 16s after the claims were applied\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m kubectl get serviceclaims -n platform-claims invoices avatars\r\n"]
[0.039, "o", "NAME       TIER    OWNER           BUDGET   FROZEN   READY   AGE\r\ninvoices   batch   team-invoices            False    True    23s\r\navatars    batch   team-avatars             False    True    23s\r\n"]
[0.113, "o", "\r\n\u001b[1;36m# In the cluster: the ACK objects paved applied. In AWS: what ACK made of them\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m kubectl get roles.iam.services.k8s.aws,buckets.s3.services.k8s.aws -n svc-invoices\r\n"]
[0.259, "o", "NAME                                 AGE\r\nrole.iam.services.k8s.aws/invoices   24s\r\n"]
[0.000, "o", "\r\nNAME                                  AGE\r\nbucket.s3.services.k8s.aws/invoices"]
[0.000, "o", "   24s\r\n"]
[0.002, "o", "\u001b[1;32m$\u001b[0m aws iam get-role --role-name paved-invoices\r\n"]
[0.703, "o", "arn:       arn:aws:iam::<account-id>:role/paved/workloads/paved-invoices\r\nboundary:  arn:aws:iam::<account-id>:policy/paved/paved-workload-boundary\r\ntrusts:    arn:aws:iam::<account-id>:oidc-provider/paved-oidc-89acfb0e43f2.s3.eu-west-2.amazonaws.com\r\n  only if  aud = sts.amazonaws.com\r\n  only if  sub = system:serviceaccount:svc-invoices:invoices\r\n"]
[0.003, "o", "\u001b[1;32m$\u001b[0m host_aws s3api get-public-access-block --bucket paved-invoices-42250471 --query PublicAccessBlockConfiguration --output text\r\n"]
[0.719, "o", "True\tTrue\tTrue\tTrue\r\n"]
[0.052, "o", "\r\n\u001b[1;36m# Proof from inside the cluster: a pod running as invoices, with the AWS identity paved gave its Rollout\u001b[0m\r\n"]
[0.115, "o", "\u001b[1;32m$\u001b[0m kubectl get pod storage-proof -n svc-invoices -o jsonpath='{.spec.containers[0].env[*].name}'\r\n"]
[0.086, "o", "AWS_ROLE_ARN AWS_WEB_IDENTITY_TOKEN_FILE AWS_REGION AWS_DEFAULT_REGION PAVED_STORAGE_BUCKET OTHER_BUCKET HOME\r\n"]
[10.602, "o", "\u001b[1;32m$\u001b[0m kubectl logs storage-proof -n svc-invoices\r\n"]
[0.057, "o", "I am:    arn:aws:sts::<account-id>:assumed-role/paved-invoices/botocore-session-1789422689\r\nwrote:   s3://paved-invoices-42250471/proof.txt\r\nread:    written by invoices at 2026-09-14T21:51:30Z\r\nlist    s3://paved-avatars-5dcf5e7e: AccessDenied\r\nwrite   s3://paved-avatars-5dcf5e7e: AccessDenied\r\n"]
[0.002, "o", "\r\n\u001b[1;36m# No AWS key anywhere in the cluster: every Secret, ConfigMap and pod, decoded and searched\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32m$\u001b[0m kubectl get secrets,configmaps,pods -A -o json | ./scan-for-aws-keys\r\n"]
[1.211, "o", "  ConfigMaps  scanned   76\r\n  Pods        scanned   32\r\n  Secrets     scanned   26\r\n  AWS keys found: 0\r\n"]
[0.006, "o", "\r\n\u001b[1;36m# invoices is retired. Its role goes with it; its bucket, and the data in it, stays\u001b[0m\r\n"]
[0.005, "o", "\u001b[1;32m$\u001b[0m kubectl delete serviceclaim invoices -n platform-claims --wait=false\r\n"]
[0.116, "o", "serviceclaim.platform.paved.dev \"invoices\" deleted from platform-claims namespace\r\n"]
[0.004, "o", "  waiting until the claim, its namespace and its ACK objects are gone\r\n"]
[0.259, "o", "  invoices  StorageReady=True  Provisioned        Ready=True    avatars   StorageReady=True  Provisioned        Ready=True    \r\n"]
[47.744, "o", "  invoices  StorageReady=                         Ready=        avatars   StorageReady=True  Provisioned        Ready=True    \r\n"]
[0.331, "o", "\u001b[1;32m$\u001b[0m aws iam get-role --role-name paved-invoices\r\n"]
[1.910, "o", "NoSuchEntity: the role is gone\r\n\u001b[1;32m$\u001b[0m host_aws s3 ls s3://paved-invoices-42250471/\r\n"]
[1.615, "o", "2026-09-14 17:51:32         44 proof.txt\r\n"]
[0.136, "o", "\r\n\u001b[1;36m# Tidying up: avatars goes too. Both buckets stay, and are the account owner's to delete\u001b[0m\r\n\u001b[1;32m$\u001b[0m kubectl delete serviceclaim avatars -n platform-claims --wait=false\r\n"]
[0.475, "o", "serviceclaim.platform.paved.dev \"avatars\" deleted from platform-claims namespace\r\n"]
[0.001, "o", "  waiting until the avatars claim is gone\r\n"]
[0.538, "o", "  invoices  StorageReady=                         Ready=        avatars   StorageReady=True  Provisioned        Ready=True    \r\n"]
[49.402, "o", "  invoices  StorageReady=                         Ready=        avatars   StorageReady=                         Ready=        \r\n"]
[0.032, "o", "\r\n\u001b[1;36m# Done: storage in 16s, Ready in 16s, cross-claim access denied, no keys, role removed 49s after its claim\u001b[0m\r\n"]
[0.000, "o", "storage_ready_seconds=16 ready_seconds=16 claim_deleted_seconds=49 kept_buckets=paved-invoices-42250471,paved-avatars-5dcf5e7e\r\n"]
[0.001, "x", "0"]
